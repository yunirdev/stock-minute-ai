# Copy to .env and fill in your own values. .env is gitignored.

# Broker: alpaca_paper (paper account) | alpaca_live (real money)
# alpaca_paper must use Paper Trading keys from the Alpaca dashboard.
BROKER_TYPE=alpaca_paper

# Data feed: alpaca
DATA_FEED_TYPE=alpaca

# Alpaca API key/secret.
# Paper and live accounts have separate keys. Mixing them can cause 401 errors.
# Get paper keys from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_DATA_FEED=sip

# Optional: default universe for data download / warm-up scripts
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA

# Market data database and trading audit database
DB_PATH=market.duckdb
TRADE_DB_PATH=trade.duckdb

# PaperDecision：正式交易决策门（始终启用）
# 先通过 UI 下载足够历史 K 线，再运行：
# uv run python -m trader.strategy_statistics --symbols AAPL,MSFT --timeframe 5m
STRATEGY_STATISTICS_PATH=conf/strategy_statistics.json
ALLOW_QUANT_WITHOUT_AI=false
UNIVERSE_MAX_SYMBOLS=20
UNIVERSE_MAX_AGE_MINUTES=1440

# 每日研究：盘前或盘后自动运行一次，盘中 Runtime 只读取冻结结果
AI_SCORE_DB=ai_states.duckdb
MIN_AI_SCORE=65
DAILY_RESEARCH_ENABLED=true
DAILY_RESEARCH_DB=ai_states.duckdb
DAILY_RESEARCH_MAX_AGE_HOURS=36
DAILY_RESEARCH_SCREEN_LIMIT=10
DAILY_RESEARCH_DEEP_LIMIT=5
DAILY_RESEARCH_CLOSE_HOUR_ET=16
DAILY_RESEARCH_CLOSE_MINUTE_ET=15

# TradingAgents 外部项目/模型（未安装时批次会明确标记 FAILED）
TRADINGAGENTS_PROJECT_DIR=
TRADINGAGENTS_PYTHON=
TRADINGAGENTS_LLM_PROVIDER=ollama
TRADINGAGENTS_DEEP_MODEL=qwen2.5:14b
TRADINGAGENTS_QUICK_MODEL=qwen2.5:14b
TRADINGAGENTS_BACKEND_URL=http://127.0.0.1:11434/v1
TRADINGAGENTS_TIMEOUT_SECONDS=7200
TRADINGAGENTS_CACHE_DIR=
TRADINGAGENTS_RESULTS_DIR=
TRADINGAGENTS_MEMORY_LOG_PATH=
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_CHECKPOINT_ENABLED=true
TRADINGAGENTS_TEMPERATURE=0.1

# 旧版手动 AgentManager 使用；DAILY_RESEARCH_ENABLED=true 时不进入 Runtime tick
AI_SCORE_MAX_AGE_MINUTES=30
AGENT_CYCLE_INTERVAL_MINUTES=15

# AI / LLM 配置
# LLM_PROVIDER: ollama(本地,免费) | anthropic(需API key) | stub(离线测试)
LLM_PROVIDER=ollama
# Ollama 本地端点
OLLAMA_BASE_URL=http://localhost:11434
# 推荐模型（按 5070Ti 16GB VRAM 优化，拉取命令：ollama pull <model>）：
#   qwen2.5:14b   — 首选：8.9GB，JSON 可靠，金融推理强，30-60s/次
#   phi4          — 次选：9.1GB，推理质量高，30-60s/次
#   gemma4        — 备选：9.6GB，已安装，20-40s/次
#   qwen2.5:7b    — 极速：4.4GB，10-20s/次，质量稍低
OLLAMA_MODEL=qwen2.5:14b
# Anthropic（可选）：先执行 uv sync --extra anthropic，再填写 key
ANTHROPIC_API_KEY=
# Ollama 推理选项
# OLLAMA_THINK=true   # 开启思考链（qwen3/gemma4 推理质量更高，但慢 3-5 倍）
#                       建议先跑通基本流程后再开启，5070Ti + 24GB 模型约需 5-15min/次
OLLAMA_THINK=false

# Discord 推送（两种方式二选一，优先 Bot Token）
# 方式 A: Bot Token + Channel ID（稳定推送，推荐）
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# 方式 B: Webhook URL（无需 Bot，简单推送）
DISCORD_WEBHOOK_URL=
DISCORD_EXTERNAL_SEND_ENABLED=false

# 新闻源（均为可选；留空则对应源静默跳过）
# SEC EDGAR 8-K 申报流：User-Agent 需含联系信息（EDGAR 要求）
SEC_USER_AGENT=stock-minute-ai/1.0 your@email.com
# Finnhub 公司新闻（免费 tier 60 req/min）：注册 https://finnhub.io 获取
FINNHUB_API_KEY=
